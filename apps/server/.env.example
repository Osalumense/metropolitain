PORT=4001
FRONTEND_ORIGIN=http://localhost:3000

# Required — get a free key at https://prim.iledefrance-mobilites.fr (see README).
# The server refuses to start without this; there is no mock/offline mode.
PRIM_API_KEY=

# Optional — get a free key at https://www.deepl.com/pro-api. Without it (or if it's
# rate-limited/quota-exhausted), translation falls back to MyMemory's free keyless API,
# and to French-only if that's unavailable too.
DEEPL_API_KEY=

# Optional — where the French->English translation cache is persisted on disk (must be
# on a writable, ideally persistent volume — see docker-compose.yml). Default shown.
TRANSLATE_CACHE_PATH=/app/cache/translate-cache.json

# Optional — DeepL call pacing/retry tuning, defaults shown. Shouldn't need to change
# unless a future DeepL account has different rate limits than this one.
TRANSLATE_MIN_CALL_INTERVAL_MS=120
TRANSLATE_RETRY_DEFAULT_MS=1500
TRANSLATE_RETRY_MAX_MS=5000

# Optional — defaults shown. The IDFM feed itself only updates ~once/minute, so
# polling positions faster than that gains nothing.
POSITION_INTERVAL_MS=90000
DISRUPTION_INTERVAL_MS=120000
