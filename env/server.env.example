PORT=4001
# Comma-separated — both the apex and www must be listed, or requests from whichever
# host isn't listed get silently blocked by the browser's own CORS enforcement.
FRONTEND_ORIGIN=https://example.com,https://www.example.com

# Required — get a free key at https://prim.iledefrance-mobilites.fr (see README).
PRIM_API_KEY=

# Optional — get a free key at https://www.deepl.com/pro-api. Without it, disruption
# text is served in French only.
DEEPL_API_KEY=

# Optional — defaults shown, tuned for production quota limits. See README.
POSITION_INTERVAL_MS=90000
DISRUPTION_INTERVAL_MS=120000
